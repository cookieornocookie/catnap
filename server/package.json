{
  "name": "snapchat-pwa-server",
  "version": "1.0.0",
  "description": "Backend server for Snapchat Web PWA with real-time sockets and Web Push notifications",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "generate-vapid": "node -e \"console.log(require('web-push').generateVAPIDKeys())\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
